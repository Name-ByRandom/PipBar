<layer id="wrap">

  <stack id="grid" direction="vertical" gap="4%" padding="4%" fill="true">

    <stack id="row0" direction="horizontal" gap="4%" mainSize="0.42">

      <layer id="pp0" interactive="true" mainSize="0.46">

        <!-- 关闭 -->
        <rect id="pp0b" coordinates="local" x="0%" y="0%" width="100%" height="100%" corner="rounded" cornerRadius="10%" color="#242424">
          <style when="pbp == 0" color="#3d7fd6" />
        </rect>
        <rect id="pp0f" coordinates="local" x="2%" y="2.5%" width="96%" height="95%" corner="rounded" cornerRadius="9%" color="#242424">
          <style when="pbp == 0" color="#1e3a5c" />
        </rect>
        <rect id="pp0k" coordinates="local" x="29%" y="8%" width="42%" height="44%" corner="rounded" cornerRadius="3%" color="transparent" strokeColor="#9aa0a6" strokeWidth="1.2%">
          <style when="pbp == 0" strokeColor="#8fc7ff" />
        </rect>
        <line id="pp0d" coordinates="local" x1="31.5%" y1="12%" x2="68.5%" y2="48%" thickness="1.2%" color="#9aa0a6">
          <style when="pbp == 0" color="#8fc7ff" />
        </line>
        <stack id="pp0c" direction="vertical" fill="true" padding="4%" justify="end">
          <text id="pp0t" size="11%" minSize="0.07" color="#9aa0a6" align="center" wrap="false">关闭
            <style when="pbp == 0" color="#8fc7ff" />
          </text>
        </stack>

      </layer>

      <layer id="pp1" interactive="true" mainSize="0.46">

        <!-- 5 : 5 -->
